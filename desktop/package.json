{
  "name": "north-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "NORTH Cloud desktop client",
  "author": "NORTH",
  "main": "main.cjs",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "test": "node --test *.test.cjs",
    "build:ui": "npm --prefix ../frontend run build -- --mode cloud --outDir ../desktop/ui --emptyOutDir && node write-default.cjs",
    "package:windows": "npm run build:ui && electron-builder --win portable --x64 --publish never",
    "package:installer": "npm run build:ui && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.north.console",
    "productName": "NORTH",
    "artifactName": "NORTH-Desktop-Windows-x64.exe",
    "files": ["main.cjs", "workspace.cjs", "cloud-proxy.cjs", "local-workspace.cjs", "device-history.cjs", "listener-history.cjs", "packet-capture.cjs", "collector-install.cjs", "preload.cjs", "setup.html", "setup.js", "setup.css", "icons/north.ico"],
    "extraResources": [
      {"from": "ui", "to": "north-ui"},
      {"from": "../backend", "to": "north-collector/backend", "filter": ["requirements.txt", "run_collector.py", "cloud_sync.py", "neighbors.py", "sysmon.py", "north.py", "device_watch.py", "event_contract.py", "windows_sources.py", "detection_rules.py", "rules.yaml", "network.py", "router_usage.py", "internet_health.py", "adapter_traffic.py", "journal_monitor.py", "NORTH-Collector.exe"]},
      {"from": "../tools", "to": "north-collector/tools", "filter": ["Start-NorthCollector.ps1", "Set-NorthCollectorStartup.ps1", "Export-NorthNeighbors.ps1", "Read-NorthSysmon.ps1", "SysmonFormat.ps1", "Read-NorthAdapterTraffic.ps1", "Read-NorthWindowsSource.ps1"]},
      {"from": "../tools", "to": "north-tools", "filter": ["Export-NorthNeighbors.ps1", "Read-NorthSysmon.ps1", "Read-NorthAdapterTraffic.ps1", "Read-NorthTcp.ps1", "SysmonFormat.ps1"]}
    ],
    "nsis": {"artifactName": "NORTH-Setup-Windows-x64.exe"},
    "win": {
      "icon": "icons/north.ico",
      "target": "portable"
    }
  }
}
